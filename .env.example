# ============================================
# IMCC Career Hub - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual API keys
# This file is safe to commit to Git (no secrets)
# ============================================

# ============================================
# JOOBLE API (Job Feed)
# ============================================
# Get your API key from: https://jooble.org/api/about
JOOBLE_API_KEY=

# ============================================
# GROQ API (AI Features)
# ============================================
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=

# ============================================
# SUPABASE (Database)
# ============================================
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# These are public client settings. Never use a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ============================================
# CRON JOB SECURITY
# ============================================
# Generate a random secret string for cron job authentication
CRON_SECRET=

# ============================================
# OPTIONAL: OPENAI API (Alternative to Groq)
# ============================================
# OPENAI_API_KEY=

# ============================================
# OPTIONAL: GOOGLE GEMINI API (Alternative to Groq)
# ============================================
# GEMINI_API_KEY=

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
NODE_ENV=development
DEBUG=false
